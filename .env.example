APP_ENV=development
HTTP_ADDR=:8080
DATABASE_URL=postgres://webhooker:webhooker@localhost:5433/webhooker?sslmode=disable
REDIS_URL=redis://localhost:6380/0

WORKER_CONCURRENCY=20
WEBHOOK_TIMEOUT=10s

MAX_RETRY_ATTEMPTS=5
RETRY_MAX_DELAY=6h
RETRY_JITTER=0.2
RETRY_SCHEDULE=30s,2m,10m,30m

MAX_EVENT_PAYLOAD_SIZE=1048576

# 32-byte base64 — generate via: openssl rand -base64 32
ENCRYPTION_KEY=MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=
ADMIN_TOKEN=dev-admin-token

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
RATE_LIMIT_RPS=100

EVENT_RETENTION_DAYS=30
ATTEMPT_RETENTION_DAYS=30
PAYLOAD_RETENTION_DAYS=7

WEBHOOK_ALLOW_PRIVATE_IPS=true
WEBHOOK_ALLOWLIST_CIDRS=
